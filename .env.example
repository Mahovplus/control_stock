# Токен бота от @BotFather. Это пароль: не публиковать.
BOT_TOKEN=
# Telegram ID су-шефа (число). Узнать можно у @userinfobot.
# Несколько су-шефов (до 4) через запятую без пробелов: 111111111,222222222
SOUS_CHEF_ID=
# Путь к файлу базы.
DB_PATH=data/ostatki.db
# Чат официантов (группа). Добавьте бота в группу, напишите там /chatid
# и впишите сюда число из ответа (у групп оно с минусом). Можно оставить пустым.
WAITERS_CHAT_ID=
# iiko Cloud API: три ключа из iikoWeb → Настройки Cloud API → Интеграции.
# Это пароли: не публиковать. Если оставить пустыми, стоп в iiko ставится вручную.
IIKO_API_KEY=
IIKO_APP_ID=
IIKO_CLIENT_SECRET=
# Можно не заполнять: бот возьмёт первую организацию и первую группу касс.
IIKO_ORG_ID=
IIKO_TERMINAL_GROUP_ID=
